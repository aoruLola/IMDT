server {
    listen 80;
    server_name study.example.com;
    root /var/www/imdt;
    index index.html;
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    charset utf-8;

    location = /843 { return 301 /843/; }
    location / { try_files $uri $uri/ =404; }
    add_header X-Content-Type-Options nosniff;
}
